# Python bytecode from tools/. This repo is published in its entirety by
# actions/upload-pages-artifact, so anything committed here is served.
__pycache__/
*.pyc

# Local-only scratch pages — preview harnesses, reference docs, anything built to
# look at rather than to publish. The .local.html suffix is the marker; name a file
# that way and it stays out of the repo, and therefore out of what Pages serves.
*.local.html
